#!/usr/bin/env bash
# Ship the drafts branch to the live site.
# Usage: scripts/publish [content/<section>/<bundle>] [--trailer "Key: value"]...
#
# With a bundle: sets `draft: false`, runs scripts/check, commits the bundle on drafts.
# Always: merges drafts into origin/main (no checkout, so the working tree and any
# uncommitted work stay put), pushes main and drafts, waits for the deploy, and
# curls the post's live URL. Each --trailer is appended to the commit messages.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export HUGO_CACHEDIR="${HUGO_CACHEDIR:-$PWD/.cache/hugo}"

bundle=""; trailers=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --trailer) trailers+=(--trailer "$2"); shift 2 ;;
    *) bundle="${1%/}"; shift ;;
  esac
done
msg() { if [[ ${#trailers[@]} -gt 0 ]]; then printf '%s\n' "$1" | git interpret-trailers "${trailers[@]}"; else printf '%s\n' "$1"; fi; }
die() { echo "publish: $*" >&2; exit 1; }

[[ "$(git branch --show-current)" == drafts ]] || die "check out the drafts branch first"

if [[ -n "$bundle" ]]; then
  f="$bundle/index.md"; [[ -f "$f" ]] || die "$f not found"
  pub=$( (grep -m1 '^publishDate:' "$f" || grep -m1 '^date:' "$f") | sed -E 's/^[a-zA-Z]+:[[:space:]]*//; s/["'\'']//g' | cut -c1-10)
  [[ "$pub" > "$(date +%F)" ]] && die "$f is dated $pub; Hugo will not build it until then. Change date/publishDate to today or earlier."
  sed -i -E '0,/^draft:/s/^draft:.*/draft: false/' "$f"
  scripts/check
  title=$(grep -m1 '^title:' "$f" | sed -E 's/^title:[[:space:]]*//; s/^"(.*)"$/\1/')
  git add -A -- "$bundle"
  git commit -q -m "$(msg "Publish $title")" -- "$bundle"
  echo "publish: committed $(git log --oneline -1)"
else
  scripts/check
  title=""
fi

git fetch -q origin
git merge-base --is-ancestor origin/drafts drafts 2>/dev/null || die "drafts is behind origin/drafts; pull first"
git merge-base --is-ancestor main origin/main || die "local main has commits not on origin/main; sort that out first"
if git merge-base --is-ancestor drafts origin/main; then
  echo "publish: main already contains drafts"; merge=$(git rev-parse origin/main)
else
  tree=$(git merge-tree --write-tree origin/main drafts) || die "drafts conflicts with main; merge by hand"
  merge=$(git commit-tree "$tree" -p origin/main -p drafts -m "$(msg "Merge branch 'drafts'${title:+: $title}")")
  git push -q origin drafts "$merge:refs/heads/main"
  echo "publish: pushed main at ${merge:0:7}"
fi
git update-ref refs/heads/main "$merge"
git push -q origin drafts 2>/dev/null || true

run=""
for _ in $(seq 30); do
  run=$(gh run list --branch main --commit "$merge" --limit 1 --json databaseId --jq '.[0].databaseId // empty' 2>/dev/null) && [[ -n "$run" ]] && break
  sleep 2
done
[[ -n "$run" ]] || die "no deploy run found for ${merge:0:7}; check: gh run list --branch main"
gh run watch "$run" --exit-status >/dev/null || die "deploy run $run failed: gh run view $run --log-failed"
echo "publish: deploy $run succeeded"

if [[ -n "$bundle" ]]; then
  url=$(hugo list all 2>/dev/null | awk -F, -v p="$f" '$1==p {print $8}' | sed 's#://ianteda.com#://www.ianteda.com#')
  [[ -n "$url" ]] || die "could not work out the live URL for $f from hugo list"
  # The CDN can lag the deploy, and a failed curl must not end the script silently under set -e.
  code=000
  for _ in $(seq 6); do
    code=$(curl -sL -o /dev/null -w '%{http_code}' "$url" || true)
    [[ "$code" == 200 ]] && break
    sleep 5
  done
  echo "publish: $url -> $code"
  [[ "$code" == 200 ]] || die "live URL did not return 200"
fi
